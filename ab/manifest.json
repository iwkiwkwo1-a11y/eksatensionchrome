{
  "manifest_version": 3,
  "name": "ab",
  "version": "1.0.0",
  "description": "Chrome extension to detect, parse, and download video streams (M3U8, MP4, HLS) captured from network and DOM.",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ab - Media Detector"
  }
}
